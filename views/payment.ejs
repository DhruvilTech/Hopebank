<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Make Payment - Hope Bank</title>
    <link rel="stylesheet" href="/stylesheet/style.css">
    <link rel="stylesheet" href="/stylesheet/login.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <style>
        .payment-card {
            max-width: 500px;
            margin: 0 auto;
        }

        .payment-methods {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
        }

        .payment-method {
            flex: 1;
            padding: 15px;
            border: 2px solid var(--secondary-color);
            border-radius: 10px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .payment-method:hover {
            border-color: var(--primary-color);
        }

        .payment-method.active {
            border-color: var(--primary-color);
            background: rgba(0, 180, 216, 0.1);
        }

        .payment-method i {
            font-size: 24px;
            margin-bottom: 8px;
            color: var(--primary-color);
        }

        .card-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .card-number {
            grid-column: 1 / -1;
        }

        .amount-display {
            text-align: center;
            margin: 20px 0;
            padding: 15px;
            background: rgba(0, 180, 216, 0.1);
            border-radius: 10px;
        }

        .amount-display h3 {
            color: var(--accent-color);
            font-size: 24px;
            margin-bottom: 5px;
        }

        .success-message {
            display: none;
            text-align: center;
            padding: 20px;
            background: #23d160;
            color: white;
            border-radius: 10px;
            margin-top: 20px;
        }

        .success-message, .failure-message {
            animation: fadeIn 0.5s ease-in;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        select.form-control {
            width: 100%;
            padding: 12px;
            border: 2px solid var(--secondary-color);
            border-radius: 12px;
            font-size: 14px;
            transition: all 0.3s ease;
            background: white;
            cursor: pointer;
        }

        select.form-control:focus {
            border-color: var(--primary-color);
            outline: none;
            box-shadow: 0 0 0 3px rgba(0, 180, 216, 0.1);
        }

        .qr-code {
            padding: 20px;
            border: 2px dashed var(--secondary-color);
            border-radius: 12px;
            margin: 20px 0;
        }

        .payment-method.active {
            border-color: var(--primary-color);
            background: rgba(0, 180, 216, 0.1);
            transform: translateY(-2px);
        }

        .verification-container {
            text-align: center;
            padding: 40px;
            max-width: 400px;
            margin: 20px auto;
            background: white;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }

        .pin-input {
            font-size: 24px;
            letter-spacing: 8px;
            text-align: center;
            width: 150px;
            margin: 20px auto;
            padding: 10px;
            border: 2px solid var(--secondary-color);
            border-radius: 8px;
        }

        .verification-hint {
            color: #666;
            font-size: 0.9em;
            margin: 10px 0;
        }

        .verification-buttons {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin-top: 20px;
        }

        .verify-btn {
            background: var(--primary-color);
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 25px;
            cursor: pointer;
        }

        .cancel-btn {
            background: #ff3860;
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 25px;
            cursor: pointer;
        }

        .failure-message {
            text-align: center;
            padding: 20px;
            background: #ff3860;
            color: white;
            border-radius: 10px;
            margin: 20px auto;
            max-width: 400px;
            animation: fadeIn 0.5s ease-in;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .amount-btn {
            padding: 12px 25px;
            border: 2px solid var(--primary-color);
            border-radius: 25px;
            background: white;
            color: var(--primary-color);
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            min-width: 100px;
            margin: 5px;
        }

        .amount-btn:hover {
            background: var(--primary-color);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 180, 216, 0.2);
        }

        .amount-btn.active {
            background: var(--primary-color);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 180, 216, 0.2);
        }

        .quick-amounts {
            display: flex;
            gap: 10px;
            margin: 20px 0;
            justify-content: center;
            flex-wrap: wrap;
        }

        /* Add mobile responsiveness for amount buttons */
        @media (max-width: 480px) {
            .amount-btn {
                padding: 10px 20px;
                font-size: 14px;
                min-width: 80px;
            }
            
            .quick-amounts {
                gap: 8px;
            }
        }
    </style>
</head>
<body>
    <section class="login-section">
        <div class="login-container">
            <div class="login-card payment-card">
                <h2 class="section-title">Make Payment</h2>
                
                <div class="amount-display">
                    <p>Donation Amount</p>
                    <h3>₹<span id="donationAmount">0</span></h3>
                </div>

                <div class="quick-amounts">
                    <button type="button" class="amount-btn" data-amount="100">₹100</button>
                    <button type="button" class="amount-btn" data-amount="500">₹500</button>
                    <button type="button" class="amount-btn" data-amount="1000">₹1000</button>
                    <button type="button" class="amount-btn" data-amount="5000">₹5000</button>
                </div>

                <form id="paymentForm" class="login-form" action="/process-payment" method="POST" novalidate>
                    
                    <div class="payment-methods">
                        <div class="payment-method active" data-method="card">
                            <i class="fas fa-credit-card"></i>
                            <p>Card</p>
                        </div>
                        <div class="payment-method" data-method="upi">
                            <i class="fas fa-mobile-alt"></i>
                            <p>UPI</p>
                        </div>
                        <div class="payment-method" data-method="netbanking">
                            <i class="fas fa-university"></i>
                            <p>Net Banking</p>
                        </div>
                    </div>

                    <div id="cardPayment">
                        <div class="form-group card-number">
                            <label for="cardNumber">Card Number</label>
                            <input type="text" id="cardNumber" placeholder="1234 5678 9012 3456" maxlength="19" required>
                        </div>
                        
                        <div class="card-info">
                            <div class="form-group">
                                <label for="expiry">Expiry Date</label>
                                <input type="text" id="expiry" placeholder="MM/YY" maxlength="5" required>
                            </div>
                            <div class="form-group">
                                <label for="cvv">CVV</label>
                                <input type="password" id="cvv" placeholder="123" maxlength="3" required>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="name">Card Holder Name</label>
                            <input type="text" id="name" placeholder="Enter card holder name" required>
                        </div>
                    </div>

                    <div id="upiPayment" style="display: none;">
                        <div class="form-group">
                            <label for="upiId">UPI ID</label>
                            <input type="text" id="upiId" placeholder="username@upi" required>
                        </div>
                    </div>

                    <div id="netbankingPayment" style="display: none;">
                        <div class="form-group">
                            <label for="bank">Select Bank</label>
                            <select id="bank" class="form-control">
                                <option value="">Select your bank</option>
                                <option value="sbi">State Bank of India</option>
                                <option value="hdfc">HDFC Bank</option>
                                <option value="icici">ICICI Bank</option>
                                <option value="axis">Axis Bank</option>
                                <option value="pnb">Punjab National Bank</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="amount">Amount</label>
                        <input type="number" 
                               name="amount" 
                               id="amount" 
                               required 
                               min="1" 
                               onchange="updateDonationAmount(this.value)">
                    </div>

                    <input type="hidden" name="paymentMethod" id="selectedPaymentMethod" value="card">
                    <button type="submit" class="cta-button">Pay Now</button>
                </form>

                <!-- Add these verification forms after your payment form -->
                <div id="upiVerification" style="display: none;" class="verification-container">
                    <h2>Enter UPI PIN</h2>
                    <p>Please enter your 4-digit UPI PIN to complete the payment</p>
                    <input type="password" id="upiPin" maxlength="4" class="pin-input" placeholder="">
                    <p class="verification-hint">Enter your 4-digit UPI PIN</p>
                    <div class="verification-buttons">
                        <button onclick="verifyUpiPayment()" class="verify-btn">Verify & Pay</button>
                        <button onclick="cancelVerification()" class="cancel-btn">Cancel</button>
                    </div>
                </div>

                <div id="cardVerification" style="display: none;" class="verification-container">
                    <h2>Enter Card OTP</h2>
                    <p>Please enter the 6-digit OTP sent to your registered mobile number</p>
                    <input type="text" id="cardOtp" maxlength="6" class="pin-input" placeholder="">
                    <p class="verification-hint">OTP has been sent to ******1234</p>
                    <div class="verification-buttons">
                        <button onclick="verifyCardPayment()" class="verify-btn">Verify & Pay</button>
                        <button onclick="cancelVerification()" class="cancel-btn">Cancel</button>
                    </div>
                </div>

                <div id="netbankingVerification" style="display: none;" class="verification-container">
                    <h2>Enter Netbanking OTP</h2>
                    <p>Please enter the 6-digit OTP sent to your registered mobile number</p>
                    <input type="text" id="netbankingOtp" maxlength="6" class="pin-input" placeholder="">
                    <p class="verification-hint">OTP has been sent to ******5678</p>
                    <div class="verification-buttons">
                        <button onclick="verifyNetbankingPayment()" class="verify-btn">Verify & Pay</button>
                        <button onclick="cancelVerification()" class="cancel-btn">Cancel</button>
                    </div>
                </div>

                <!-- Add this failure message div -->
                <div id="failureMessage" class="failure-message" style="display: none;">
                    <i class="fas fa-times-circle"></i>
                    <h3>Payment Failed!</h3>
                    <p>Invalid verification code. Please try again.</p>
                    <p class="redirect-text">Redirecting in <span id="countdown">5</span> seconds...</p>
                </div>
            </div>
        </div>
    </section>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const paymentMethods = document.querySelectorAll('.payment-method');
            const cardPayment = document.getElementById('cardPayment');
            const upiPayment = document.getElementById('upiPayment');
            const netbankingPayment = document.getElementById('netbankingPayment');
            const selectedPaymentMethod = document.getElementById('selectedPaymentMethod');

            paymentMethods.forEach(method => {
                method.addEventListener('click', function() {
                    // Remove active class from all methods
                    paymentMethods.forEach(m => m.classList.remove('active'));
                    // Add active class to clicked method
                    this.classList.add('active');
                    
                    const methodType = this.dataset.method;
                    selectedPaymentMethod.value = methodType;

                    // Hide all payment forms
                    cardPayment.style.display = 'none';
                    upiPayment.style.display = 'none';
                    netbankingPayment.style.display = 'none';

                    // Show selected payment form
                    if (methodType === 'card') cardPayment.style.display = 'block';
                    if (methodType === 'upi') upiPayment.style.display = 'block';
                    if (methodType === 'netbanking') netbankingPayment.style.display = 'block';
                });
            });

            const amountButtons = document.querySelectorAll('.amount-btn');
            const amountInput = document.getElementById('amount');

            amountButtons.forEach(button => {
                button.addEventListener('click', function() {
                    // Remove active class from all buttons
                    amountButtons.forEach(btn => btn.classList.remove('active'));
                    // Add active class to clicked button
                    this.classList.add('active');
                    
                    // Update amount input and display
                    const amount = this.dataset.amount;
                    amountInput.value = amount;
                    updateDonationAmount(amount);
                });
            });

            // Add expiry date validation
            document.getElementById("expiry").addEventListener("input", function(e) {
                let input = this.value;
                
                // Auto-format input to add '/'
                if (input.length === 2 && !input.includes('/')) {
                    this.value = input + '/';
                }

                if (input.length === 5) {
                    const [month, year] = input.split("/");
                    const currentDate = new Date();
                    const currentMonth = currentDate.getMonth() + 1;
                    const currentYear = currentDate.getFullYear() % 100;

                    const expiryMonth = parseInt(month, 10);
                    const expiryYear = parseInt(year, 10);

                    if (expiryYear < currentYear || 
                        (expiryYear === currentYear && expiryMonth < currentMonth)) {
                        alert("The expiry date has passed. Please enter a valid date.");
                        this.value = '';  // Clear invalid input
                    }

                    // Validate month range
                    if (expiryMonth < 1 || expiryMonth > 12) {
                        alert("Please enter a valid month (01-12)");
                        this.value = '';
                    }
                }
            });
        });

        function updateDonationAmount(value) {
            document.getElementById('donationAmount').textContent = value || '0';
        }

        // Verification codes
        const VERIFICATION_CODES = {
            upi: '9072',
            card: '654125',
            netbanking: '612543'
        };

        // Update form submission handler
        document.getElementById('paymentForm').onsubmit = async function(e) {
            e.preventDefault();
            
            // Get all required values
            const amount = document.getElementById('amount').value;
            const method = document.getElementById('selectedPaymentMethod').value;
            const submitButton = this.querySelector('button[type="submit"]');
            
            try {
                // Basic validation
                if (!amount || parseFloat(amount) <= 0) {
                    alert('Please enter a valid amount');
                    return;
                }

                // Validate based on payment method
                switch(method) {
                    case 'card':
                        if (!validateCardDetails()) return;
                        break;
                    case 'upi':
                        if (!validateUpiDetails()) return;
                        break;
                    case 'netbanking':
                        if (!validateNetbankingDetails()) return;
                        break;
                }

                // Disable button and show loading state
                submitButton.disabled = true;
                submitButton.textContent = 'Processing...';

                // Show appropriate verification form
                document.getElementById('paymentForm').style.display = 'none';
                switch(method) {
                    case 'upi':
                        document.getElementById('upiVerification').style.display = 'block';
                        break;
                    case 'card':
                        document.getElementById('cardVerification').style.display = 'block';
                        break;
                    case 'netbanking':
                        document.getElementById('netbankingVerification').style.display = 'block';
                        break;
                }
            } catch (error) {
                console.error('Payment submission error:', error);
                alert('An error occurred while processing your payment. Please try again.');
            } finally {
                // Re-enable button
                submitButton.disabled = false;
                submitButton.textContent = 'Pay Now';
            }
        };

        // Add validation functions
        function validateCardDetails() {
            const cardNumber = document.getElementById('cardNumber').value;
            const expiry = document.getElementById('expiry').value;
            const cvv = document.getElementById('cvv').value;
            const name = document.getElementById('name').value;

            if (!cardNumber || !expiry || !cvv || !name) {
                alert('Please fill in all card details');
                return false;
            }
            return true;
        }

        function validateUpiDetails() {
            const upiId = document.getElementById('upiId').value;
            if (!upiId) {
                alert('Please enter UPI ID');
                return false;
            }
            return true;
        }

        function validateNetbankingDetails() {
            const bank = document.getElementById('bank').value;
            if (!bank) {
                alert('Please select a bank');
                return false;
            }
            return true;
        }

        async function verifyPayment(method, code) {
            try {
                if (code === VERIFICATION_CODES[method]) {
                    const response = await fetch('/verify-payment', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            method: method,
                            verificationCode: code,
                            amount: document.getElementById('amount').value,
                            receiverId: '<%= receiver._id %>'
                        })
                    });

                    const data = await response.json();
                    if (data.success) {
                        window.location.href = `/payment-success/${data.payment.id}`;
                    } else {
                        showFailure();
                    }
                } else {
                    showFailure();
                }
            } catch (error) {
                console.error('Payment error:', error);
                showFailure();
            }
        }

        function verifyUpiPayment() {
            const pin = document.getElementById('upiPin').value;
            verifyPayment('upi', pin);
        }

        function verifyCardPayment() {
            const otp = document.getElementById('cardOtp').value;
            verifyPayment('card', otp);
        }

        function verifyNetbankingPayment() {
            const otp = document.getElementById('netbankingOtp').value;
            verifyPayment('netbanking', otp);
        }

        function cancelVerification() {
            document.getElementById('upiVerification').style.display = 'none';
            document.getElementById('cardVerification').style.display = 'none';
            document.getElementById('netbankingVerification').style.display = 'none';
            document.getElementById('paymentForm').style.display = 'block';
        }

        function showFailure() {
            document.getElementById('upiVerification').style.display = 'none';
            document.getElementById('cardVerification').style.display = 'none';
            document.getElementById('netbankingVerification').style.display = 'none';
            document.getElementById('failureMessage').style.display = 'block';
            startCountdown();
        }

        function startCountdown() {
            let timeLeft = 5;
            const countdownElement = document.getElementById('countdown');
            
            const countdownInterval = setInterval(() => {
                timeLeft--;
                countdownElement.textContent = timeLeft;
                
                if (timeLeft <= 0) {
                    clearInterval(countdownInterval);
                    window.location.reload();
                }
            }, 1000);
        }
    </script>
</body>
</html>