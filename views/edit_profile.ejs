<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile | HopeBank</title>
    <link rel="stylesheet" href="/stylesheet/receiver.css">
    <link rel="stylesheet" href="/stylesheet/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        .edit-profile-container {
            max-width: 800px;
            margin: 120px auto 50px;
            padding: 30px;
            background: var(--text-white);
            border-radius: 20px;
            box-shadow: 0 5px 20px rgba(2, 62, 138, 0.1);
        }

        .edit-header {
            text-align: center;
            margin-bottom: 40px;
            position: relative;
        }

        .edit-header::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 4px;
            background: var(--gradient-teal);
            border-radius: 2px;
        }

        .edit-header h1 {
            color: var(--text-dark);
            font-size: 2.5rem;
            margin-bottom: 10px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            display: block;
            color: var(--text-dark);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid var(--bg-secondary);
            border-radius: 10px;
            font-size: 16px;
            transition: all 0.3s ease;
            background: var(--bg-primary);
            color: var(--text-dark);
        }

        .form-group input:focus,
        .form-group textarea:focus,
        .form-group select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 4px rgba(0, 180, 216, 0.1);
            outline: none;
        }

        .image-upload-container {
            text-align: center;
            margin-bottom: 30px;
        }

        .current-image {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            margin: 0 auto 20px;
            border: 4px solid var(--primary-color);
            overflow: hidden;
        }

        .current-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .file-input-wrapper {
            position: relative;
            margin-top: 15px;
        }

        .file-input-wrapper input[type="file"] {
            display: none;
        }

        .file-input-label {
            display: inline-block;
            padding: 12px 25px;
            background: var(--gradient-teal);
            color: white;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .file-input-label:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 180, 216, 0.3);
        }

        .form-actions {
            display: flex;
            gap: 15px;
            justify-content: flex-end;
            margin-top: 30px;
        }

        .update-btn, .cancel-btn {
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .update-btn {
            background: var(--gradient-teal);
            color: white;
            border: none;
        }

        .cancel-btn {
            background: #ff4d4d;
            color: white;
            text-decoration: none;
            text-align: center;
        }

        .update-btn:hover, .cancel-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }

        @media (max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .edit-profile-container {
                margin: 100px 20px 50px;
                padding: 20px;
            }
        }
    </style>
</head>

<body>
    <header>
        <div class="container">
            <nav>
                <div class="logo">
                    <i class="fas fa-hand-holding-heart"></i>
                    <span>Hope Bank</span>
                </div>
                <div class="nav-links" id="navLinks">
                    <a href="/receiv/home">home</a>
                    
                       
                
                    <a href="/logout" class="cta-button login-btn">Logout</a>
                </div>
                <div class="menu-toggle" id="mobileMenu">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </nav>
        </div>
    </header>

    <main style="padding-top: 100px;">
        <div class="container">
            <div class="edit-profile-container">
                <div class="edit-header">
                    <h1>Edit Profile</h1>
                    <p>Update your profile information</p>
                </div>

                <form action="/receiv/edit_profile" method="POST" enctype="multipart/form-data">
                    <div class="image-upload-container">
                        <div class="current-image">
                            <img src="<%= receiver.image %>" alt="Current profile" id="preview-image">
                        </div>
                        <div class="file-input-wrapper">
                            <label class="file-input-label">
                                <i class="fas fa-camera"></i> Change Photo
                                <input type="file" name="image" accept="image/*" onchange="previewImage(this)">
                            </label>
                        </div>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label for="Username">Username</label>
                            <input type="text" id="Username" name="Username" value="<%= receiver.Username %>" required>
                        </div>

                        <div class="form-group">
                            <label for="email">Email</label>
                            <input type="email" id="email" name="email" value="<%= receiver.email %>" required>
                        </div>

                        <div class="form-group">
                            <label for="phone">Phone Number</label>
                            <input type="tel" id="phone" name="phone" value="<%= receiver.phone %>" required>
                        </div>

                        <div class="form-group">
                            <label for="causes">Category</label>
                            <select id="causes" name="causes" required>
                                <option value="Education" <%= receiver.causes === 'Education' ? 'selected' : '' %>>Education</option>
                                <option value="Medical" <%= receiver.causes === 'Medical' ? 'selected' : '' %>>Medical</option>
                                <option value="NGOs" <%= receiver.causes === 'NGOs' ? 'selected' : '' %>>NGOs</option>
                                <option value="Animal" <%= receiver.causes === 'Animal' ? 'selected' : '' %>>Animal Welfare</option>
                                <option value="Children/Elderly People" <%= receiver.causes === 'Children/Elderly People' ? 'selected' : '' %>>Children/Elderly People</option>
                                <option value="Other" <%= receiver.causes === 'Other' ? 'selected' : '' %>>Other</option>
                            </select>
                        </div>

                        <div class="form-group full-width">
                            <label for="address">Address</label>
                            <textarea id="address" name="address" rows="3" required><%= receiver.address %></textarea>
                        </div>

                        <div class="form-group">
                            <label for="requiredMoney">Required Amount (₹)</label>
                            <input type="number" id="requiredMoney" name="requiredMoney" value="<%= receiver.requiredMoney %>" required>
                        </div>

                        <div class="form-group full-width">
                            <label for="Description">Description</label>
                            <textarea id="Description" name="Description" rows="4" required><%= receiver.Description %></textarea>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a href="/receiv/home" class="cancel-btn">Cancel</a>
                        <button type="submit" class="update-btn">Update Profile</button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <!-- Footer -->
    
    <footer>
        <div class="row">
            <div class="col">
                <div class="logo">
                    <i class="fas fa-hand-holding-heart"></i>
                    <span>Hope Bank</span>
                </div>
                <br>
                <p>HopeBank is a platform that helps people to contribute to different causes like education, healthcare, animal welfare, and more, easily and securely.</p>
            </div>
            <div class="col">
                <h3>Causes</h3>
                <ul class="footerlist">
                    <li>Medical</li>
                    <li>Crowdfunding</li>
                    <li>Education</li>
                    <li>Animal Welfare</li>
                    <li>NGOs or Charities</li>
                    <li>Orphanage</li>
                </ul>
            </div>
            <div class="col">
                <h3>Links</h3>
                <ul class="footerlist">
                    <li><a href="/receiv/home">Home</a></li>
                    <li><a href="/receiv/edit_profile">profile</a></li>
                </ul>
            </div>
            <div class="col">
                <h3>Connect with Us</h3>
                <div class="icon">
                    <a href="https://facebook.com" class="a1"><i class="fa-brands fa-facebook"></i></a>
                    <a href="https://instagram.com"><i class="fa-brands fa-instagram"></i></a>
                    <a href="https://whatsapp.com"><i class="fa-brands fa-whatsapp"></i></a>
                </div>
            </div>
        </div>
        <div id="row2">
            <p class="copywrite">HopeBank © copyrights 2024-2025</p>
        </div>
    </footer> 

    <!-- Scripts -->
    <script src="/javascript/script.js"></script>
    <script>
        // Mobile menu toggle functionality
        const mobileMenu = document.getElementById('mobileMenu');
        const navLinks = document.getElementById('navLinks');

        mobileMenu.addEventListener('click', () => {
            navLinks.classList.toggle('active');
            mobileMenu.classList.toggle('active');
            document.body.classList.toggle('menu-open');
        });

        // Close mobile menu when clicking outside
        document.addEventListener('click', (e) => {
            if (!navLinks.contains(e.target) && !mobileMenu.contains(e.target)) {
                navLinks.classList.remove('active');
                mobileMenu.classList.remove('active');
                document.body.classList.remove('menu-open');
            }
        });

        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('preview-image').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
     <script src="/javascript/script.js"></script>
    
</body>

</html>