<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Wishlist - Hope Bank</title>
    <link rel="stylesheet" href="/stylesheet/style.css">
    <link rel="stylesheet" href="/stylesheet/login.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <style>
        .wishlist-section {
            padding: 120px 20px 40px;
        }

        .section-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .section-header h1 {
            color: var(--text-dark);
            font-size: 2.5rem;
            margin-bottom: 10px;
        }

        .cases-section {
            max-width: 1200px;
            margin: 0 auto;
        }

        .wishlist-grid, .receivers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            padding: 20px 0;
        }

        .case-card {
            background: rgba(255, 255, 255, 0.9);
            border-radius: 30px;
            padding: 40px 30px;
            box-shadow: 0 10px 30px rgba(2, 62, 138, 0.1);
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .case-card:hover {
            transform: translateY(-15px) scale(1.03);
            box-shadow: 0 20px 40px rgba(0, 180, 216, 0.2);
            border-color: var(--secondary-color);
        }

        .case-image-container {
            width: 100%;
            height: 250px;
            overflow: hidden;
        }

        .case-image {
            width: 100%;
            height: 100%; 
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .case-title {
            font-size: 1.4rem;
            color: var(--text-dark);
            margin-bottom: 15px;
            font-weight: 600;
        }

        .case-details {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 20px;
        }

        .case-details p {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-light);
            font-size: 0.95rem;
        }

        .case-details i {
            width: 20px;
            color: var(--primary-color);
        }

        .case-amount {
            font-weight: 600;
            color: var(--accent-color) !important;
        }

        .donate-btn {
            background: var(--primary-color);
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            width: 100%;
            margin-top: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .donate-btn:hover {
            background: var(--accent-color);
            transform: translateY(-2px);
        }

        .section-divider {
            border-top: 2px solid var(--secondary-color);
            margin: 60px 0;
            text-align: center;
            position: relative;
        }

        .section-divider h2 {
            background: var(--bg-primary);
            padding: 0 20px;
            display: inline-block;
            position: relative;
            top: -15px;
            color: var(--text-dark);
            font-size: 1.8rem;
        }

        .empty-message {
            text-align: center;
            padding: 40px;
            background: white;
            border-radius: 15px;
            margin: 20px 0;
            color: var(--text-light);
        }

        .empty-message i {
            font-size: 48px;
            color: var(--primary-color);
            margin-bottom: 15px;
        }

        .wishlist-btn {
            background: var(--bg-secondary);
            color: var(--text-dark);
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            width: 100%;
            margin-top: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .wishlist-btn:hover {
            background: var(--secondary-color);
            transform: translateY(-2px);
        }

        .wishlist-btn.added {
            background: var(--primary-color);
            color: white;
        }

        .wishlist-btn.added i {
            color: white;
        }

        .card-buttons {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .remove-btn {
            background: #ff3860;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .remove-btn:hover {
            background: #ff1443;
            transform: translateY(-2px);
        }

        @keyframes fadeOut {
            from { opacity: 1; transform: scale(1); }
            to { opacity: 0; transform: scale(0.95); }
        }

        /* Mobile Responsive */
        @media screen and (max-width: 768px) {
            .cases-section {
                padding: 100px 15px 40px;
            }

            .wishlist-grid, .receivers-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .case-image-container {
                height: auto;
                width: auto;
            }

            .case-content {
                padding: 15px;
            }

            .case-title {
                font-size: 1.2rem;
            }

            .case-details p {
                font-size: 0.9rem;
            }

            .card-buttons {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header>
        <div class="container">
            <nav>
                <div class="logo">
                    <i class="fas fa-hand-holding-heart"></i>
                    <span>Hope Bank</span>
                </div>
                <div class="nav-links" id="navLinks">
                    <a href="/">Home</a>
                    <a href="/about">About</a>
                    <a href="/contact">Contact</a>
                    <% if (locals.isLoggedIn) { %>
                        <div class="user-menu">
                            <div class="profile-dropdown">
                                <button class="profile-icon">
                                    <i class="fas fa-user-circle"></i>
                                </button>
                                <div class="dropdown-content">
                                    <a href="/profile">Profile</a>
                                    <a href="/Wishlist">Wishlist</a>
                                    <a href="/history">History</a>
                                </div>
                            </div>
                            <a href="/logout" class="cta-button login-btn">Logout</a>
                        </div>
                    <% } else { %>
                        <a href="/login" class="cta-button login-btn">Login</a>
                    <% } %>
                </div>
                <div class="menu-toggle" id="mobileMenu">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </nav>
        </div>
    </header>

    <!-- Main Content -->
    <main class="wishlist-section">
        <div class="container">
            <div class="section-header">
                <h1>My Wishlist</h1>
            </div>

            <% if (wishlistItems && wishlistItems.length > 0) { %>
                <div class="wishlist-grid">
                    <% wishlistItems.forEach(function(item) { %>
                        <% if (item.donationId) { %>
                            <div class="case-card">
                                <div class="case-image-container">
                                    <img src="<%= item.donationId.image || '/default-image.jpg' %>" 
                                         alt="<%= item.donationId.Username || 'Unknown' %>" class="case-image">
                                </div>
                                <div class="case-content">
                                    <h3 class="case-title"><%= item.donationId.Username || 'Unknown' %></h3>
                                    <div class="case-details">
                                        <p><i class="fas fa-rupee-sign"></i> Required: 
                                            ₹<%= item.donationId.requiredMoney ? item.donationId.requiredMoney.toLocaleString() : 'N/A' %>
                                        </p>
                                        <p><i class="fas fa-tag"></i> Cause: 
                                            <%= item.donationId.causes || 'Not specified' %>
                                        </p>
                                    </div>
                                    <a href="/payment/<%= item.donationId._id %>"><button class="donate-now-btn">
                                        <i class="fas fa-heart"></i> Donate Now
                                    </button></a>
                                    <br><br>
                                    <button class="remove-btn" onclick="removeFromWishlist('<%= item.donationId._id %>', this)">
                                        <i class="fas fa-trash"></i> Remove
                                    </button>
                                </div>
                            </div>
                        <% } %>
                    <% }); %>
                </div>
            <% } %>
        </div>

            <!-- Section Divider -->
            <div class="section-divider">
                <h2>All Available Causes</h2>
            </div>

            <!-- All Receivers -->
            <% if (allReceivers && allReceivers.length > 0) { %>
                <div class="receivers-grid">
                    <% allReceivers.forEach(function(receiver) { %>
                        <div class="case-card">
                            <div class="case-image-container">
                                <img src="<%= receiver.image || '/default-image.jpg' %>" 
                                     alt="<%= receiver.Username || 'Unknown' %>" class="case-image">
                            </div>
                            <div class="case-content">
                                <h3 class="case-title"><%= receiver.Username || 'Unknown' %></h3>
                                <div class="case-details">
                                    <p><i class="fas fa-rupee-sign"></i> Required: 
                                        ₹<%= receiver.requiredMoney ? receiver.requiredMoney.toLocaleString() : 'N/A' %>
                                    </p>
                                    <p><i class="fas fa-tag"></i> Cause: 
                                        <%= receiver.causes || 'Not specified' %>
                                    </p>
                                </div>
                                <button class="wishlist-btn" onclick="addToWishlist('<%= receiver._id %>', this)">
                                    <i class="fas fa-bookmark"></i> Add to Wishlist
                                </button>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-message">
                    <i class="fas fa-info-circle"></i>
                    <p>No causes available at the moment</p>
                </div>
            <% } %>
        </div>
    </main>

    <!-- Footer -->
    
    <footer>
        <div class="row">
            <div class="col">
                <div class="logo">
                    <i class="fas fa-hand-holding-heart"></i>
                    <span>Hope Bank</span>
                </div>
                <br>
                <p>HopeBank is a platform that helps people to contribute to different causes like education, healthcare, animal welfare, and more, easily and securely.</p>
            </div>
            <div class="col">
                <h3>Causes</h3>
                <ul class="footerlist">
                    <li>Medical</li>
                    <li>Crowdfunding</li>
                    <li>Education</li>
                    <li>Animal Welfare</li>
                    <li>NGOs or Charities</li>
                    <li>Orphanage</li>
                </ul>
            </div>
            <div class="col">
                <h3>Links</h3>
                <ul class="footerlist">
                    <li><a href="/">Home</a></li>
                    <li><a href="/about">About Us</a></li>
                    <li><a href="/contact">Contact</a></li>
                    <li><a href="/login">Login</a></li>
                </ul>
            </div>
            <div class="col">
                <h3>Connect with Us</h3>
                <div class="icon">
                    <a href="https://facebook.com" class="a1"><i class="fa-brands fa-facebook"></i></a>
                    <a href="https://instagram.com"><i class="fa-brands fa-instagram"></i></a>
                    <a href="https://whatsapp.com"><i class="fa-brands fa-whatsapp"></i></a>
                </div>
            </div>
        </div>
        <div id="row2">
            <p class="copywrite">HopeBank © copyrights 2024-2025</p>
        </div>
    </footer> 

    <script src="/javascript/script.js"></script>
    <script>
    async function addToWishlist(donationId, button) {
        try {
            const response = await fetch('/add-to-wishlist', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ donationId })
            });

            const data = await response.json();
            if (data.success) {
                button.classList.add('added');
                button.innerHTML = '<i class="fas fa-bookmark"></i> Added to Wishlist';
                setTimeout(() => {
                    window.location.reload();
                }, 1000);
            } else {
                alert(data.message || 'Already in wishlist');
            }
        } catch (error) {
            alert('Failed to add to wishlist');
        }
    }

    async function removeFromWishlist(donationId, button) {
        if (confirm('Are you sure you want to remove this item from your wishlist?')) {
            try {
                const response = await fetch(`/remove-from-wishlist/${donationId}`, {
                    method: 'DELETE'
                });

                const data = await response.json();
                if (data.success) {
                    // Remove the card from the UI
                    const card = button.closest('.case-card');
                    card.style.animation = 'fadeOut 0.3s ease';
                    setTimeout(() => {
                        card.remove();
                        // If no items left, reload to show empty message
                        if (document.querySelectorAll('.case-card').length === 0) {
                            window.location.reload();
                        }
                    }, 300);
                } else {
                    alert(data.message || 'Failed to remove from wishlist');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Failed to remove from wishlist');
            }
        }
    }
    </script>
</body>
</html>
