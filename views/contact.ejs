<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - Hope Bank</title>
    <link rel="shortcut icon" href="/imager/image.png">
    <link rel="stylesheet" href="/stylesheet/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <style>
        .contact-hero {
            padding: 180px 0 80px;
            text-align: center;
            position: relative;
            overflow: hidden;
            background: linear-gradient(rgba(2, 62, 138, 0.7), rgba(0, 180, 216, 0.7)), url('https://images.unsplash.com/photo-1596524430615-b46475ddff6e?ixlib=rb-1.2.1&auto=format&fit=crop&w=1920&q=80');
            background-size: cover;
            background-position: center;
            color: white;
            animation: fadeIn 1s ease-out;
        }

        .contact-info {
            padding: 60px 0;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .info-card {
            background: rgba(255, 255, 255, 0.9);
            padding: 30px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(2, 62, 138, 0.1);
            transition: all 0.3s ease;
            animation: slideUp 0.5s ease-out forwards;
            opacity: 0;
        }


        .info-card:hover {
            transform: translateY(-15px) scale(1.03);   
            box-shadow: 0 15px 35px rgba(0, 180, 216, 0.2);
        }

        .info-icon {
            font-size: 2.5rem;
            color: var(--primary-color);
            margin-bottom: 20px;
            transition: transform 0.3s ease;
        }

        .info-card:hover .info-icon {
            transform: scale(1.1);
        }

        .info-card h3 {
            color: var(--text-dark);
            margin-bottom: 15px;
        }

        .info-card p {
            color: var(--text-light);
            line-height: 1.6;
        }

        .contact-form-section {
            padding: 60px 0;
            background: rgba(255, 255, 255, 0.9);
            margin: 20px;
            border-radius: 30px;
            box-shadow: 0 10px 30px rgba(2, 62, 138, 0.1);
            animation: fadeIn 1s ease-out 0.8s forwards;
            opacity: 0;
        }

        .contact-form {
            max-width: 800px;
            margin: 0 auto;
            padding: 40px;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-dark);
            font-weight: 500;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 12px;
            border: 2px solid rgba(0, 180, 216, 0.2);
            border-radius: 10px;
            font-size: 16px;
            transition: all 0.3s ease;
        }

        .form-group input:hover,
        .form-group textarea:hover {
            border-color: var(--primary-color);
        }

        .form-group input:focus,
        .form-group textarea:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 10px rgba(0, 180, 216, 0.1);
            outline: none;
        }

        .map-section {
            padding: 60px 0;
            animation: fadeIn 1s ease-out 1s forwards;
            opacity: 0;
        }

        .map-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .map-frame {
            width: 100%;
            height: 400px;
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(2, 62, 138, 0.1);
            transition: all 0.3s ease;
        }

        .map-frame:hover {
            box-shadow: 0 15px 35px rgba(0, 180, 216, 0.2);
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media screen and (max-width: 768px) {
            .info-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .contact-form {
                padding: 20px;
            }

            .map-frame {
                height: 300px;
            }
        }
        button
        {
            border: none;
        }



        
    </style>
</head>
<body>
    <header>
        <div class="container">
            <nav>
                <div class="logo">
                    <i class="fas fa-hand-holding-heart"></i>
                    <span>Hope Bank</span>
                </div>
                <div class="nav-links" id="navLinks">
                    <a href="/">Home</a>
                    <a href="/about">About</a>
                    <a href="/contact">Contact</a>
                    <% if (locals.isLoggedIn) { %>
                        <div class="user-menu">
                            <div class="profile-dropdown">
                                <button class="profile-icon">
                                    <i class="fas fa-user-circle"></i>
                                </button>
                                <div class="dropdown-content">
                                    <a href="/profile">Profile</a>
                                    <a href="/Wishlist">Wishlist</a>
                                    <a href="/history">History</a>
                                </div>
                            </div>
                            <a href="/logout" class="cta-button login-btn">Logout</a>
                        </div>
                    <% } else { %>
                        <a href="/login" class="cta-button login-btn">Login</a>
                    <% } %>
                </div>
                <div class="menu-toggle" id="mobileMenu">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </nav>
        
        </div>
    </header>

    <section class="contact-hero">
        <div class="container">
            <h1 class="section-title">Contact Us</h1>
            <p>We're here to help and answer any questions you might have</p>
        </div>
    </section>

    <section class="contact-info">
        <div class="info-grid">
            <div class="info-card">
                <div class="info-icon">
                    <i class="fas fa-map-marker-alt"></i>
                </div>
                <h3>Visit Us</h3>
                <p>Polytechnic</p>
                <p>Vadodara, PIN 390020</p>
            </div>

            <div class="info-card">
                <div class="info-icon">
                    <i class="fas fa-phone"></i>
                </div>
                <h3>Call Us</h3>
                <p>+91 - 9727804230</p>
                <p>Monday to Friday</p>
                <p>9:00 AM - 6:00 PM</p>
            </div>

            <div class="info-card">
                <div class="info-icon">
                    <i class="fas fa-envelope"></i>
                </div>
                <h3>Email Us</h3>
                <p>hopebank@gmail.com</p>
                <p>We'll respond within 24 hours</p>
            </div>
        </div>
    </section>

    <section class="map-section">
        <div class="map-container">
            <h2 class="section-title">Find Us</h2>
            <!-- <iframe class="map-frame" 
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3887.3660079789814!2d77.71636631482283!3d13.002969090835768!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bae1196bb3b9163%3A0x5c9919abe4eef5e!2sITPL%20Rd%2C%20Whitefield%2C%20Bengaluru%2C%20Karnataka!5e0!3m2!1sen!2sin!4v1645523456789!5m2!1sen!2sin">
            </iframe> -->
            <iframe class="map-frame" 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3690.7930503208236!2d73.17552747507001!3d22.323665179669813!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x395fc8cbb1849e4f%3A0x57fbad12488b0544!2sPolytechnic%2C%20The%20Maharaja%20Sayajirao%20University%20of%20Baroda!5e0!3m2!1sen!2sin!4v1739199575072!5m2!1sen!2sin"></iframe>
        </div>
    </section>

    <footer>
        <div class="row">
            <div class="col">
                <div class="logo">
                    <i class="fas fa-hand-holding-heart"></i>
                    <span>Hope Bank</span>
                </div>
                <br>
                <p>HopeBank is a platform that helps people to contribute to different causes like education, healthcare, animal welfare, and more, easily and securely.</p>
            </div>
            <div class="col">
                <h3>Causes</h3>
                <ul class="footerlist">
                    <li>Medical</li>
                    <li>Crowdfunding</li>
                    <li>Education</li>
                    <li>Animal Welfare</li>
                    <li>NGOs or Charities</li>
                    <li>Orphanage</li>
                </ul>
            </div>
            <div class="col">
                <h3>Links</h3>
                <ul class="footerlist">
                    <li><a href="/">Home</a></li>
                    <li><a href="/about">About Us</a></li>
                    <li><a href="/contact">Contact</a></li>
                    <li><a href="/login">Login</a></li>
                </ul>
            </div>
            <div class="col">
                <h3>Connect with Us</h3>
                <div class="icon">
                    <br>
                    <br>
                    <br>
                    <br>
                    <a href="https://facebook.com"><i class="fa-brands fa-facebook"></i></a>
                    <a href="https://instagram.com"><i class="fa-brands fa-instagram"></i></a>
                    <a href="https://whatsapp.com"><i class="fa-brands fa-whatsapp"></i></a>

                </div>
            </div>
        </div>
        <div id="row2">
            <p class="copywrite">HopeBank © 2024 - All Rights Reserved</p>
        </div>
    </footer>

    <script src="/javascript/script.js"></script>
</body>
</html>
