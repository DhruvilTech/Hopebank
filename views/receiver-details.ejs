<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= receiver.Username %> - Hope Bank</title>
    <link rel="stylesheet" href="/stylesheet/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <style>
        .receiver-container {
            padding: 120px 20px 40px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .receiver-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            margin-bottom: 30px;
            transition: transform 0.3s ease;
        }

        .receiver-card:hover {
            transform: translateY(-5px);
        }

        .receiver-header {
    position: relative;
    width: 100%;
    height: 400px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f5f5; /* Optional: Adds a background */
}

.receiver-image {
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain; /* Ensures the image is fully visible without cutting */
    object-position: center; /* Centers the image */
    transition: transform 0.5s ease;
}

.receiver-header:hover .receiver-image {
    transform: scale(1.05);
}


        .cause-tag {
            position: absolute;
            top: 20px;
            left: 20px;
            background: var(--primary-color);
            color: white;
            padding: 10px 20px;
            border-radius: 50px;
            font-size: 16px;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(0, 180, 216, 0.3);
            z-index: 1;
            backdrop-filter: blur(5px);
        }

        .receiver-content {
            padding: 40px;
        }

        .receiver-title {
            font-size: 36px;
            color: var(--text-dark);
            margin-bottom: 25px;
            border-bottom: 3px solid var(--primary-color);
            padding-bottom: 15px;
            display: inline-block;
        }

        .fund-status {
            background: var(--bg-primary);
            padding: 30px;
            border-radius: 20px;
            margin: 30px 0;
            box-shadow: 0 5px 20px rgba(0, 180, 216, 0.1);
        }

        .fund-details {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .fund-item {
            background: white;
            padding: 20px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            transition: transform 0.3s ease;
        }

        .fund-item:hover {
            transform: translateY(-5px);
        }

        .fund-label {
            color: var(--text-light);
            font-size: 14px;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .fund-value {
            color: var(--text-dark);
            font-size: 28px;
            font-weight: 700;
        }

        .fund-value.highlight {
            color: var(--primary-color);
            font-size: 32px;
        }

        .progress-bar-container {
            background: #e0e0e0;
            height: 10px;
            border-radius: 5px;
            margin: 20px 0;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            background: var(--primary-color);
            border-radius: 5px;
            transition: width 1s ease-in-out;
        }

        .description-section {
            margin: 30px 0;
            line-height: 1.8;
            color: var(--text-light);
            background: rgba(0, 180, 216, 0.05);
            padding: 30px;
            border-radius: 20px;
            border-left: 5px solid var(--primary-color);
            font-size: 16px;
        }

        .contact-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin: 30px 0;
        }

        .contact-item {
            background: var(--bg-primary);
            padding: 25px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            gap: 20px;
            transition: all 0.3s ease;
        }

        .contact-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 180, 216, 0.1);
        }

        .contact-icon {
            width: 50px;
            height: 50px;
            background: var(--primary-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            transition: transform 0.3s ease;
        }

        .contact-item:hover .contact-icon {
            transform: rotate(360deg);
        }

        .contact-info {
            flex: 1;
        }

        .contact-label {
            color: var(--text-light);
            font-size: 14px;
            margin-bottom: 5px;
        }

        .contact-value {
            color: var(--text-dark);
            font-weight: 600;
            font-size: 16px;
        }

        .document-section {
            margin: 40px 0;
        }

        .document-title {
            font-size: 24px;
            color: var(--text-dark);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .document-title i {
            color: var(--primary-color);
        }

        .pdf-viewer {
            width: 100%;
            height: 600px;
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .action-buttons {
            display: flex;
            gap: 20px;
            margin-top: 40px;
        }

        .action-button {
            flex: 1;
            padding: 18px 30px;
            border: none;
            border-radius: 15px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .donate-btn {
            background: var(--primary-color);
            color: white;
            box-shadow: 0 8px 20px rgba(0, 180, 216, 0.3);
        }

        .donate-btn:hover {
            background: var(--accent-color);
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(0, 180, 216, 0.4);
        }

        .wishlist-btn {
            background: var(--bg-secondary);
            color: var(--text-dark);
        }

        .wishlist-btn.active {
            background: var(--accent-color);
            color: white;
        }

        .wishlist-btn:hover {
            background: var(--text-dark);
            color: white;
            transform: translateY(-3px);
        }

        @media (max-width: 768px) {
            .receiver-header {
                height: 300px;
            }

            .fund-details {
                grid-template-columns: 1fr;
            }

            .contact-section {
                grid-template-columns: 1fr;
            }

            .action-buttons {
                flex-direction: column;
            }

            .receiver-content {
                padding: 20px;
            }

            .receiver-title {
                font-size: 28px;
            }
        }
        a{
            text-decoration: none;
        }
    </style>
</head>
<body>
    <header>
        <div class="container">
            <nav>
                <div class="logo">
                    <i class="fas fa-hand-holding-heart"></i>
                    <span>Hope Bank</span>
                </div>
                <div class="nav-links" id="navLinks">
                    <a href="/">Home</a>
                    <a href="/about">About</a>
                    <a href="/contact">Contact</a>
                    <% if (locals.isLoggedIn) { %>
                        <div class="user-menu">
                            <div class="profile-dropdown">
                                <button class="profile-icon">
                                    <i class="fas fa-user-circle"></i>
                                </button>
                                <div class="dropdown-content">
                                    <a href="/profile">Profile</a>
                                    <a href="/Wishlist">Wishlist</a>
                                    <a href="/history">History</a>
                                </div>
                            </div>
                            <a href="/logout" class="cta-button login-btn">Logout</a>
                        </div>
                    <% } else { %>
                        <a href="/login" class="cta-button login-btn">Login</a>
                    <% } %>
                </div>
                <div class="menu-toggle" id="mobileMenu">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </nav>
        </div>
    </header>
    
                <% if (isLoggedIn) { %>
                    <div class="receiver-container">
        <div class="receiver-card">
            <div class="receiver-header">
                <img src="<%= receiver.image %>" alt="<%= receiver.Username %>" class="receiver-image">
                <span class="cause-tag"><%= receiver.causes %></span>
            </div>

            <div class="receiver-content">
                <h1 class="receiver-title"><%= receiver.Username %></h1>

                <div class="fund-status">
                    <div class="fund-details">
                        <div class="fund-item">
                            <div class="fund-label">Raised Amount</div>
                            <div class="fund-value highlight">₹<%= totalReceived.toLocaleString() %></div>
                        </div>
                        <div class="fund-item">
                            <div class="fund-label">Required Amount</div>
                            <div class="fund-value">₹<%= receiver.requiredMoney.toLocaleString() %></div>
                        </div>
                        <div class="fund-item">
                            <div class="fund-label">Progress</div>
                            <div class="fund-value"><%= Math.round(progress) %>%</div>
                        </div>
                    </div>
                    
                </div>

                <div class="description-section">
                    <p><%= receiver.Description %></p>
                </div>

                <div class="contact-section">
                    <div class="contact-item">
                        <div class="contact-icon">
                            <i class="fas fa-phone"></i>
                        </div>
                        <div class="contact-info">
                            <div class="contact-label">Phone Number</div>
                            <div class="contact-value"><%= receiver.phone %></div>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-icon">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div class="contact-info">
                            <div class="contact-label">Email Address</div>
                            <div class="contact-value"><%= receiver.email %></div>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-icon">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <div class="contact-info">
                            <div class="contact-label">Location</div>
                            <div class="contact-value"><%= receiver.address %></div>
                        </div>
                    </div>
                </div>

                <div class="document-section">
                    <h2 class="document-title">
                        <i class="fas fa-file-pdf"></i>
                        Supporting Documents
                    </h2>
                    <iframe src="<%= receiver.certificate %>" class="pdf-viewer"></iframe>
                </div>


                    <div class="action-buttons">
                        <a href="/payment/<%= receiver._id %>" class="donate-now-btn" >
                            <i class="fas fa-heart"></i> Donate Now
                        </a>
                    </div>
               
                <% } else { %>
                    <div class="login-prompt">
                        <p>Please <a href="/login">login</a> to donate or save to wishlist</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    <footer>
        <div class="row">
            <div class="col">
                <div class="logo">
                    <i class="fas fa-hand-holding-heart"></i>
                    <span>Hope Bank</span>
                </div>
                <br>
                <p>HopeBank is a platform that helps people to contribute to different causes like education, healthcare, animal welfare, and more, easily and securely.</p>
            </div>
            <div class="col">
                <h3>Causes</h3>
                <ul class="footerlist">
                    <li>Medical</li>
                    <li>Crowdfunding</li>
                    <li>Education</li>
                    <li>Animal Welfare</li>
                    <li>NGOs or Charities</li>
                    <li>Orphanage</li>
                </ul>
            </div>
            <div class="col">
                <h3>Links</h3>
                <ul class="footerlist">
                    <li><a href="/">Home</a></li>
                    <li><a href="/about">About Us</a></li>
                    <li><a href="/contact">Contact</a></li>
                    <li><a href="/donor">Donate</a></li>
                    <li><a href="/services">Services</a></li>
                </ul>
            </div>
            <div class="col">
                <h3>Connect with Us</h3>
                <div class="icon">
                    <br>
                    <br>
                    <br>
                    <br>
                    <a href="https://facebook.com" class="a1"><i class="fa-brands fa-facebook"></i></a>
                    <a href="https://instagram.com"><i class="fa-brands fa-instagram"></i></a>
                    <a href="https://whatsapp.com"><i class="fa-brands fa-whatsapp"></i></a>
                </div>
            </div>
        </div>
        <div id="row2">
            <p class="copywrite">HopeBank © copyrights 2024-2025</p>
        </div>
    </footer> 
    <script>
        async function toggleWishlist(receiverId) {
            try {
                const response = await fetch('/wishlist/toggle', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ receiverId })
                });

                const data = await response.json();
                if (data.success) {
                    const button = document.querySelector('.wishlist-btn');
                    button.classList.toggle('active');
                    button.innerHTML = button.classList.contains('active') 
                        ? '<i class="fas fa-bookmark"></i> Saved'
                        : '<i class="fas fa-bookmark"></i> Save';
                } else {
                    alert('Failed to update wishlist');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error updating wishlist');
            }
        }

        // Handle PDF loading error
        document.querySelector('.pdf-viewer').onerror = function() {
            this.style.display = 'none';
            const errorMsg = document.createElement('div');
            errorMsg.innerHTML = `
                <div style="text-align: center; padding: 20px; background: #fff5f5; border-radius: 10px;">
                    <i class="fas fa-exclamation-circle" style="color: #ff3860; font-size: 24px;"></i>
                    <p style="margin-top: 10px; color: #ff3860;">Failed to load document</p>
                </div>
            `;
            this.parentNode.appendChild(errorMsg);
        };
    </script>
    <script src="/javascript/script.js"></script>
</body>
</html>
